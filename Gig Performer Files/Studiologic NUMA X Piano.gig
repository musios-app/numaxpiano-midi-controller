<?xml version="1.0" encoding="UTF-8"?>

<GIGRACK activeRackSpace="1" gbpm="120.0" gtimeNum="4" gtimeDen="4" gTranspose="0"
         version="5.0" scriptWindowPos="1813 285 692 547" globalStereoCount="2"
         globalPanelVisible="0">
  <SCRIPT_CONTENT>var 
    // Must be the exact MIDI name of your NUMA X Piano
    DeviceName : String = &quot;XPIANO73&quot;
    
    // Must match the alias for XPIANO device in Rig Manager
    NumaXPiano : MidiInDeviceAlias


// Zone 1..4 Press
//   MIDI CC numbers are #12..15
// 
// Value map...
//   From Numa           | GP Mute        | Inverted
//   Zone Enabled = 1    | Mute Off = 0   | 127
//   Zone Disabled != 1  | Mute On = 127  | 0
//
// Use non-inverted to control a Mute button. A bit confusing because light on/off is opposite

Var Zone_Press_Invert : Boolean = true

On ControlChangeEvent(msg : ControlChangeMessage) Matching [12..15] from NumaXPiano
    var mapValue : Integer = GetCCValue(msg)

    mapValue = If mapValue == 1 Then 0 Else 127 End
    If Zone_Press_Invert Then mapValue = 127 - mapValue End

    msg = WithCCValue(msg, mapValue)
    InjectMidiEvent(DeviceName, msg)
End



// FX-A Press
//   MIDI CC numbers are #69, 74, 79, 84
//   Values are off=0 and on=EffectNumber (&gt;0)
//
// Convert to GP on/off
//   MIDI CC unchanged
//   Values to Off=0 and On=127
//
//   OR...
//   Use inverted value for Mute=127 and Unmute=0

Var
    FXA_Press_Invert : Boolean = false
    FXA_Press_CCnums : Integer Array = [69, 74, 79, 84]

On ControlChangeEvent(msg : ControlChangeMessage) Matching [69..84] from NumaXPiano
    var mapValue : Integer = GetCCValue(msg)

    If IndexOf(FXA_Press_CCnums, GetCCNumber(msg)) &gt; 0
    Then
        mapValue = If mapValue == 0 Then 0 Else 127 End
        If FXA_Press_Invert Then mapValue = 127 - mapValue End

        msg = WithCCValue(msg, mapValue)
    End

    InjectMidiEvent(DeviceName, msg)
End


var
    // FX B controls
    FXB_Press_Invert : Boolean = false
    FXB_Press_CCnums : Integer Array = [101, 106, 111, 116]

On ControlChangeEvent(msg : ControlChangeMessage) Matching [101..116] from NumaXPiano
    var mapValue : Integer = GetCCValue(msg)

    If IndexOf(FXB_Press_CCnums, GetCCNumber(msg)) &gt; 0
    Then
        mapValue = If mapValue == 0 Then 0 Else 127 End
        If FXB_Press_Invert Then mapValue = 127 - mapValue End

        msg = WithCCValue(msg, mapValue)
    End

    InjectMidiEvent(DeviceName, msg)
End


</SCRIPT_CONTENT>
