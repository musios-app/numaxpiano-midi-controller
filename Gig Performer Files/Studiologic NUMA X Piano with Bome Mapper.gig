<?xml version="1.0" encoding="UTF-8"?>

<GIGRACK activeRackSpace="0" gbpm="120.0" gtimeNum="4" gtimeDen="4" gTranspose="0"
         version="5.0" scriptWindowPos="928 463 692 547" globalStereoCount="2"
         globalPanelVisible="0">
  <SCRIPT_CONTENT>Var
    NumaXPiano : MidiInDeviceAlias
    NumaXPianoProxy : MidiInDeviceAlias

On ControlChangeEvent(m : ControlChangeMessage) from NumaXPianoProxy
    Print(m)
    InjectMidiEventViaRigManager(NumaXPianoProxy, WithChannel(m, 16))
End

On MidiEvent(m : MidiMessage) from NumaXPiano
    Print(m)
    If (!IsController(m)) Then
        InjectMidiEventViaRigManager(NumaXPianoProxy, WithChannel(m, 16))
    End
End

</SCRIPT_CONTENT>
